# ---------------------------------------------------------------------------
# Wroffy Rank — environment variables
# Copy to `.env` and fill in. NEVER commit `.env`.
# All of these are server-side only. Do NOT prefix any of them with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL=postgresql://ourranktracker:ourranktracker@localhost:5432/ourranktracker?schema=public

# Docker Compose only: the password the bundled PostgreSQL is created with, and
# the one the app then connects with. Set a strong one BEFORE the first start —
# Postgres reads it only when it initialises its data directory, so changing it
# afterwards does not change an existing database (see README > Docker).
# Ignored when you point DATABASE_URL at your own database.
POSTGRES_PASSWORD=ourranktracker

# Secret used to sign session cookies. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=

# DataForSEO credentials (https://app.dataforseo.com/api-access)
# These are used server-side only and are never sent to the browser.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# How many keywords to check against DataForSEO in parallel.
SERP_CONCURRENCY=3

# Hard cap on keywords per ranking check.
MAX_KEYWORDS_PER_CHECK=500

# SERP depth (number of organic results to inspect). Max 700.
SERP_RESULTS=100

# How long a SERP response stays cached before it is re-fetched.
SERP_CACHE_MINUTES=30

# How many times to re-ask DataForSEO when it answers with an empty SERP
# (status 40102 "No Search Results." / items: null). Waits 2s, 5s then 10s
# between attempts. 0 disables the retries. Max 5.
SERP_EMPTY_RETRIES=3

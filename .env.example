# ---------------------------------------------------------------------------
# OurRankTracker — environment variables
# Copy to `.env` and fill in. NEVER commit `.env`.
# All of these are server-side only. Do NOT prefix any of them with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL=postgresql://ourranktracker:ourranktracker@localhost:5432/ourranktracker?schema=public

# Secret used to sign session cookies. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=

# DataForSEO credentials (https://app.dataforseo.com/api-access)
# These are used server-side only and are never sent to the browser.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# How many keywords to check against DataForSEO in parallel.
SERP_CONCURRENCY=3

# Hard cap on keywords per ranking check.
MAX_KEYWORDS_PER_CHECK=500

# SERP depth (number of organic results to inspect). Max 700.
SERP_RESULTS=100

# How long a SERP response stays cached before it is re-fetched.
SERP_CACHE_MINUTES=30

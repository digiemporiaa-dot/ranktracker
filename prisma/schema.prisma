// Wroffy Rank — Prisma schema
// Datasource: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  /// Can see and manage every user's data, and provision accounts.
  SUPERADMIN
  /// Sees only their own projects. Every other permission is unchanged.
  EXECUTIVE
}

enum Device {
  DESKTOP
  MOBILE
}

/// The outcome of one ranking check.
///
/// RANKED and NOT_RANKED are measurements: a SERP was read. SERP_UNAVAILABLE
/// and API_ERROR are not — they record that we tried and could not see the
/// SERP, which says nothing at all about the website. Keeping them apart is
/// what stops a provider outage from being written into the history as a lost
/// ranking.
enum SerpStatus {
  /// A SERP was read and the tracked domain was in it. `position` is set.
  RANKED
  /// A SERP was read and the tracked domain was not in it. `position` is null.
  NOT_RANKED
  /// The provider returned no SERP (status 40102 / items null) after retries.
  SERP_UNAVAILABLE
  /// Auth, billing, network or request failure — the call never completed.
  API_ERROR
}

enum RankCheckStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(EXECUTIVE)
  /// Deactivated users keep their data but cannot sign in.
  isActive     Boolean  @default(true)
  isDemo       Boolean  @default(false)
  /// Audit trail: which superadmin provisioned this account.
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects Project[]
  sessions Session[]

  // SetNull, so removing a superadmin never cascades into deleting the
  // executives they created.
  createdBy    User?  @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreator")

  @@index([email])
  @@index([role])
  @@index([createdById])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id           String   @id @default(cuid())
  userId       String
  name         String
  /// Normalized registrable host, e.g. "wroffy.com"
  domain       String
  /// Search settings applied to keywords added from now on.
  country      String   @default("IN")
  /// Optional. Null means the whole country is searched.
  city         String?
  /// DataForSEO location id resolved from country + city. Never user-entered.
  locationCode Int      @default(2356)
  /// Google property searched, e.g. "google.co.in". Derived from the country.
  googleDomain String   @default("google.com")
  language     String   @default("en")
  /// One or both devices. Each device is checked with its own SERP request.
  devices      Device[] @default([DESKTOP])
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  keywords   Keyword[]
  rankChecks RankCheck[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, createdAt])
}

model Keyword {
  id                    String    @id @default(cuid())
  projectId             String
  keyword               String
  targetUrl             String?
  country               String    @default("IN")
  /// Optional. Null means this keyword is checked at country level.
  city                  String?
  /// The location actually sent to DataForSEO. Resolved server-side.
  locationCode          Int       @default(2356)
  /// The Google property actually searched for this keyword.
  googleDomain          String    @default("google.com")
  language              String    @default("en")
  device                Device    @default(DESKTOP)
  active                Boolean   @default(true)
  /// When a SERP was last actually read for this keyword — RANKED or
  /// NOT_RANKED, never an attempt that failed. Null until the first one.
  lastSuccessfulCheckAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rankings Ranking[]

  // A keyword is unique per project + location + language + device.
  //
  // The location is identified by locationCode rather than by (country, city):
  // one code names exactly one place, and unlike a nullable city column it
  // cannot be NULL — which in Postgres would make every country-level row
  // distinct from every other and defeat the constraint entirely.
  @@unique([projectId, keyword, locationCode, language, device])
  @@index([projectId])
  @@index([projectId, active])
  @@index([projectId, locationCode, device])
}

model Ranking {
  id               String     @id @default(cuid())
  keywordId        String
  /// What this row is: a measurement, or a failed attempt. Read `position`
  /// only when this is RANKED or NOT_RANKED.
  status           SerpStatus @default(NOT_RANKED)
  /// 1..depth when RANKED. Null for every other status — including when the
  /// SERP could not be read, which is not a position of zero.
  position         Int?
  rankingUrl       String?
  /// Total organic results inspected. Null when no SERP was read at all.
  resultsChecked   Int?
  /// DataForSEO status code of the last attempt, e.g. 20000 or 40102.
  apiStatusCode    Int?
  /// DataForSEO status message of the last attempt, e.g. "No Search Results.".
  apiStatusMessage String?
  /// How many provider requests this row cost, including retries.
  attempts         Int?
  /// Where this position came from, copied from the keyword at check time so a
  /// recorded position can always be read back with its own configuration
  /// rather than whatever the keyword happens to say later.
  device           Device
  locationCode     Int
  googleDomain     String
  rankCheckId      String?
  checkedAt        DateTime   @default(now())
  createdAt        DateTime   @default(now())

  keyword   Keyword    @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  rankCheck RankCheck? @relation(fields: [rankCheckId], references: [id], onDelete: SetNull)

  @@index([keywordId])
  @@index([checkedAt])
  @@index([keywordId, checkedAt])
  @@index([keywordId, device, checkedAt])
  // The dashboard reads the latest *measured* row per keyword, skipping over
  // any failed attempts on top of it.
  @@index([keywordId, status, checkedAt])
  @@index([rankCheckId])
}

model RankCheck {
  id                String          @id @default(cuid())
  projectId         String
  status            RankCheckStatus @default(PENDING)
  totalKeywords     Int             @default(0)
  completedKeywords Int             @default(0)
  failedKeywords    Int             @default(0)
  /// User-safe message, e.g. why the run failed. Never contains provider internals.
  message           String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime        @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rankings Ranking[]

  @@index([projectId])
  @@index([status])
  @@index([projectId, createdAt])
}

/// Short-lived response cache.
///
/// Holds two kinds of row, told apart by the key prefix: SERP responses keyed
/// by keyword+location+language+device+depth, and the DataForSEO city list for
/// a country. Both are provider responses with a TTL, so they share one table
/// rather than duplicating the same three columns in a second model.
model SerpCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
